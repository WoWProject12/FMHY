location = /api/playback/vaplayer-resolve {
        include /etc/nginx/snippets/chillflix-scraper-deny.conf;
        include /etc/nginx/snippets/chillflix-scraper-advertise.conf;
        proxy_intercept_errors on;
        # Multi-title: allow short bursts without hard-failing Auto walks.
        limit_req zone=cf_resolve_limit burst=24 nodelay;
        limit_req_status 429;
        error_page 502 503 504 = @vaplayer_resolve_busy;

        # Do NOT nginx-cache resolve. Caching 200 ok:false/pending for 45s made
        # first-open empty while unlock already finished (manual click worked).
        # Disk unlock-cache is the real hot path.
        proxy_cache off;
        add_header Cache-Control "no-store" always;
        add_header X-VA-Cache "BYPASS" always;

        # Prefer player-b; A wedges under unlock stampede.
        proxy_pass http://chillflix_vaplayer;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 2s;
        proxy_send_timeout 12s;
        proxy_read_timeout 12s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
    }

    