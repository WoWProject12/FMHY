+/* VIDRIFT_BOOT_FETCH_V2 */
+function isVidriftHostname(hostname) {
+    const host = String(hostname || "").toLowerCase()
+    return host === "vidrift.net" || host.endsWith(".vidrift.net")
+}
+function decodeDataParam(raw) {
+    if (!raw) return undefined
+    try {
+        const parsed = JSON.parse(decodeURIComponent(String(raw)))
+        if (typeof parsed?.url !== "string" || !parsed.url) return undefined
+        const headers =
+            parsed.headers && typeof parsed.headers === "object" && !Array.isArray(parsed.headers)
+                ? Object.fromEntries(
+                      Object.entries(parsed.headers).filter(([, v]) => typeof v === "string")
+                  )
+                : {}
+        return { url: parsed.url, headers }
+    } catch {
+        return undefined
+    }
+}
+function encodeDataParam(url, headers) {
+    return encodeURIComponent(JSON.stringify({ url, headers: headers || {} }))
+}
+function rewriteVidriftManifest(manifest, masterUrl, proxyHeaders, pt) {
+    const master = new URL(masterUrl)
+    return manifest
+        .split("\n")
+        .map((line) => {
+            const trimmed = line.trim()
+            if (!trimmed) return line
+            if (trimmed.startsWith("#")) {
+                return line.replace(/URI="([^"]+)"/g, (full, uri) => {
+                    try {
+                        const abs = new URL(uri, master).toString()
+                        const proxied =
+                            `/api/cinepro/proxy?data=${encodeDataParam(abs, proxyHeaders)}` +
+                            (pt ? `&pt=${encodeURIComponent(pt)}` : "")
+                        return `URI="${proxied}"`
+                    } catch {
+                        return full
+                    }
+                })
+            }
+            try {
+                const abs = new URL(trimmed, master).toString()
+                const proxied =
+                    `/api/cinepro/proxy?data=${encodeDataParam(abs, proxyHeaders)}` +
+                    (pt ? `&pt=${encodeURIComponent(pt)}` : "")
+                return line.replace(trimmed, proxied)
+            } catch {
+                return line
+            }
+        })
+        .join("\n")
+}
+function serveVidriftPlaylist(req, res, payload, pt) {
+    const method = req.method === "HEAD" ? "HEAD" : "GET"
+    const range = typeof req.headers.range === "string" ? req.headers.range : undefined
+    const headers = {
+        Accept: "*/*",
+        ...(payload.headers || {}),
+    }
+    if (range) headers.Range = range
+    const upstream = http.request(
+        {
+            hostname: "127.0.0.1",
+            port: Number(process.env.SEVENMOVIES_BOOT_PORT || 3887) || 3887,
+            path: `/fetch?url=${encodeURIComponent(payload.url)}`,
+            method: "GET",
+            headers,
+            timeout: 45_000,
+        },
+        (upstreamRes) => {
+            const chunks = []
+            upstreamRes.on("data", (c) => chunks.push(c))
+            upstreamRes.on("end", () => {
+                const status = upstreamRes.statusCode || 502
+                const body = Buffer.concat(chunks)
+                if (status >= 400) {
+                    writeJson(res, status, {
+                        error: "Vidrift fetch failed.",
+                        detail: body.toString("utf8").slice(0, 200),
+                    })
+                    return
+                }
+                const text = body.toString("utf8")
+                const rewritten = rewriteVidriftManifest(
+                    text,
+                    payload.url,
+                    payload.headers || {},
+                    pt
+                )
+                const out = Buffer.from(rewritten, "utf8")
+                res.writeHead(200, {
+                    "content-type": "application/vnd.apple.mpegurl",
+                    "content-length": out.length,
+                    "cache-control": "no-store",
+                    ...CORS,
+                })
+                if (method === "HEAD") res.end()
+                else res.end(out)
+            })
+        }
+    )
+    upstream.on("error", () => {
+        if (!res.headersSent) writeJson(res, 502, { error: "Vidrift boot fetch offline." })
+    })
+    upstream.end()
+}
